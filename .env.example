# ─────────────────────────────────────────────────────────────────────────────
# Expenn — full configuration reference
#
# These are the variables the applications themselves read, whatever runs them:
# docker compose, a bare `dotnet Expenn.Api.dll`, Kubernetes, Fly, Render, a
# systemd unit. Nothing here assumes the bundled compose stack — point
# ConnectionStrings__DefaultConnection at a managed Postgres, Storage__* at S3
# or R2, RabbitMq__* at CloudAMQP, and the images run unchanged.
#
# docker-compose.yml is one such runner, and it is deliberately narrow: it reads
# only the short names in the "docker compose only" block at the bottom and
# composes them into the variables below, because it always wires the bundled
# db/minio/rabbitmq containers. To run compose against something external
# instead, drop that service and set the real variable in a compose override
# file — the block at the bottom is compose's vocabulary, not the app's.
#
# Copy to .env and fill in. Everything that is not a secret already carries a
# working localhost default, so a copy of this file runs the bundled compose
# stack once you fill the handful of values marked FILL ME at the bottom.
#
# Secrets are deliberately empty: a tracked file must never be mistakable for
# usable credentials. Values marked REQUIRED have no safe default and the app
# refuses to start without them.
#
# .env is gitignored. Keep it in this same order so a diff between the two stays
# readable, and never commit it.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Public URLs ═════════════════════════════════════════════════════════════
# Used to derive CORS, callbacks and the API base the browser/app talks to.
# Also the defaults docker-compose feeds to the per-service variables below.

# Where the web app is served from (browser-visible origin).
APP_URL=http://localhost:3000
# Where the API is reachable from the browser and mobile app (public origin).
API_URL=http://localhost:5000
# Where uploaded files are served from (MinIO/S3 public origin or CDN).
STORAGE_URL=http://localhost:9000


# ═══ API — ASP.NET Core (api/) ═══════════════════════════════════════════════
# .NET binds configuration from env vars using `__` for nesting:
# Storage__AccessKey  ==  { "Storage": { "AccessKey": ... } }

# ── Runtime ──────────────────────────────────────────────────────────────────
# Set to Production when deploying.
ASPNETCORE_ENVIRONMENT=Development
# Interface/port the Kestrel server binds. The image already sets :8080.
ASPNETCORE_URLS=http://+:8080
# "true" when a separate job runs EF migrations instead of the app on boot.
SKIP_MIGRATIONS=false

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Npgsql connection string. Only needed when running the API outside compose —
# compose builds its own from POSTGRES_PASSWORD at the bottom of this file.
# Local:   Host=localhost;Port=5432;Database=expenn;Username=expenn;Password=<POSTGRES_PASSWORD>
# Managed: Host=db.example.com;Port=5432;Database=expenn;Username=expenn;Password=…;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=

# ── JWT (Secret REQUIRED) ────────────────────────────────────────────────────
# FILL ME — at least 32 chars. Generate: openssl rand -base64 48
# Only needed outside compose; compose passes JWT_SECRET from the bottom block.
Jwt__Secret=
Jwt__Issuer=expenn-api
Jwt__Audience=expenn-clients
Jwt__ExpirationDays=30

# ── CORS ─────────────────────────────────────────────────────────────────────
# Indexed array. Add __1, __2, … for more origins. Must include the web origin
# and, for the mobile app, its scheme.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=expenn://

# ── Object storage — MinIO / S3 / R2 (REQUIRED) ──────────────────────────────
# Endpoint is what the API talks to; PublicUrl is what browsers are handed.
# For AWS S3: Endpoint=https://s3.eu-west-1.amazonaws.com, UsePathStyle=false.
Storage__Endpoint=http://localhost:9000
Storage__PublicUrl=http://localhost:9000
Storage__AccessKey=expenn
# FILL ME outside compose — compose passes MINIO_PASSWORD from the bottom block.
Storage__SecretKey=
Storage__Bucket=expenn
Storage__UsePathStyle=true
Storage__MaxSizeMb=12

# ── Message broker — RabbitMQ (optional) ─────────────────────────────────────
# Optional: with Enabled=false, MassTransit uses an in-memory transport and the
# API works without a broker. Compose starts one and turns this on.
RabbitMq__Enabled=false
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Username=expenn
# FILL ME outside compose — compose passes RABBITMQ_PASSWORD from the bottom block.
RabbitMq__Password=

# ── Email (optional — SMTP or Resend, not both) ──────────────────────────────
# With no SMTP host and no Resend key the API logs the message instead of
# sending it, which is what you want locally — OTP codes appear in the API log.
Email__From=Expenn <noreply@expenn.app>
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__SmtpSsl=true
# Resend HTTP API, an alternative to SMTP.
Email__ResendApiKey=

# ── Active Directory / Entra ID (optional) ───────────────────────────────────
ActiveDirectory__Enabled=false
# "ldap" for on-premises AD, "azure" for Microsoft Entra ID.
ActiveDirectory__Mode=ldap
ActiveDirectory__LdapHost=
ActiveDirectory__LdapPort=389
ActiveDirectory__LdapSsl=false
ActiveDirectory__LdapBaseDn=
ActiveDirectory__LdapBindDn=
ActiveDirectory__LdapBindPassword=
ActiveDirectory__LdapUserSearchFilter=(&(objectClass=user)(sAMAccountName={0}))
ActiveDirectory__LdapEmailAttribute=mail
ActiveDirectory__LdapNameAttribute=displayName
ActiveDirectory__TenantId=
ActiveDirectory__ClientId=
ActiveDirectory__ClientSecret=

# ── OIDC single sign-on (optional) ───────────────────────────────────────────
Oidc__Enabled=false
# Label on the sign-in button, e.g. "Contoso SSO".
Oidc__ProviderName=SSO
# Issuer base URL, without /.well-known/openid-configuration.
Oidc__Authority=
Oidc__ClientId=
Oidc__ClientSecret=
Oidc__Scopes=openid email profile
Oidc__WebCallbackUrl=
Oidc__MobileCallbackUrl=expenn://auth/oidc-callback

# ── Security knobs ───────────────────────────────────────────────────────────
# Swagger describes every auth flow — leave off in production.
Security__EnableSwagger=true
# HSTS and forwarded headers are off for a plain-HTTP localhost. Turn both on
# when deploying behind TLS and a reverse proxy.
Security__EnableHsts=false
Security__HstsMaxAgeDays=365
# Required behind a reverse proxy so scheme, host and client IP are correct.
Security__UseForwardedHeaders=false
# Indexed array. Empty means "trust any proxy" — only correct when nothing but
# the proxy can reach the container.
Security__KnownProxies__0=
Security__RateLimit__Enabled=true
Security__RateLimit__PermitLimit=300
Security__RateLimit__WindowSeconds=60
# Tighter budget for the credential and OTP endpoints.
Security__RateLimit__AuthPermitLimit=10
Security__RateLimit__AuthWindowSeconds=60


# ═══ Web — Next.js (web/) ════════════════════════════════════════════════════

# ── Build time (NEXT_PUBLIC_* are inlined into the bundle) ───────────────────
# Changing these needs a rebuild, not a restart. When building the image
# yourself, pass them as --build-arg APP_URL / NEXT_PUBLIC_DOTNET_API_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public API origin the browser calls directly.
NEXT_PUBLIC_DOTNET_API_URL=http://localhost:5000

# ── Runtime ──────────────────────────────────────────────────────────────────
# API base for server-side calls. Can be an internal address the browser never
# sees (service DNS, private network); falls back to the public one.
DOTNET_API_URL=http://localhost:5000
# Port/host the Next server binds. The image already sets 3000 / 0.0.0.0.
PORT=3000
HOSTNAME=0.0.0.0


# ═══ Mobile — Expo (mobile/) ═════════════════════════════════════════════════
# Read from mobile/.env, not this file — listed here so the full surface is in
# one place. Baked into the JS bundle at build time; never put secrets here.

# API base the app calls. On a physical device replace localhost with your
# machine's LAN IP (e.g. http://192.168.1.20:5000) — a device cannot reach
# localhost on your laptop.
EXPO_PUBLIC_API_URL=http://localhost:5000


# ═══ docker compose only — FILL ME ═══════════════════════════════════════════
# The only values you must supply to run the bundled stack. They are bootstrap
# credentials for the db/minio/rabbitmq containers, and compose composes them
# into the app-native variables above. Ignored entirely when you deploy the
# images against managed services — in that case the credentials live in the
# connection strings above instead.
#
# Any local-only string works; these never leave your machine.

POSTGRES_PASSWORD=
MINIO_PASSWORD=
RABBITMQ_PASSWORD=
# Compose feeds this to the API's Jwt__Secret. At least 32 chars:
# openssl rand -base64 48
JWT_SECRET=
