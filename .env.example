# Copy to .env and fill the empty values. Never commit .env.

# Ports
WEB_PORT=3001
API_PORT=5000
EXPO_PORT=8082
POSTGRES_PORT=5433
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Public URLs
APP_URL=http://localhost:3001
API_URL=http://localhost:5000
STORAGE_URL=http://localhost:9010

# Secrets
POSTGRES_PASSWORD=
MINIO_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=

# API (native runs; Compose sets these itself)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
ConnectionStrings__DefaultConnection=
Jwt__Secret=
Cors__AllowedOrigins__0=http://localhost:3001
Storage__Endpoint=http://localhost:9010
Storage__PublicUrl=http://localhost:9010
Storage__AccessKey=expenn
Storage__SecretKey=

# Web and mobile
DOTNET_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_DOTNET_API_URL=http://localhost:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Optional: route planning
OpenRouteService__ApiKey=
