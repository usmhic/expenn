{
  "name": "expenn-traveler",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "start": "node ../scripts/with-root-env.mjs --mobile expo start",
    "android": "node ../scripts/with-root-env.mjs --mobile expo start --android",
    "ios": "node ../scripts/with-root-env.mjs --mobile expo start --ios",
    "web": "node ../scripts/with-root-env.mjs --mobile expo start --web",
    "build": "node ../scripts/with-root-env.mjs --mobile expo export --platform web",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~54.0.12",
    "typescript": "^5.3.3"
  }
}
